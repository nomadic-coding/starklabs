<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Fallback when inline_form_view_id is not linked on the provider record. -->
    <template id="payment_method_form_tilopay" inherit_id="payment.method_form">
        <xpath expr="//div[@name='o_payment_inline_form']" position="inside">
            <t t-if="provider_sudo.code == 'tilopay'
                     and not inline_form_xml_id
                     and provider_sudo._should_build_inline_form(is_validation=mode == 'validation')"
               t-call="payment_tilopay.inline_form"/>
        </xpath>
    </template>

</odoo>
