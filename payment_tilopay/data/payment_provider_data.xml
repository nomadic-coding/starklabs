<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="payment_provider_tilopay" model="payment.provider">
        <field name="name">Tilopay</field>
        <field name="code">tilopay</field>
        <field name="image_128" type="base64" file="payment_tilopay/static/img/tilopay_logo.png" />
        <field name="is_published">True</field>
        <field name="inline_form_view_id" ref="inline_form" />
        <field name="allow_tokenization">False</field>
        <field name="payment_method_ids" eval="[Command.set([ref('payment_tilopay.payment_method_tilopay')])]" />
    </record>

</odoo>
